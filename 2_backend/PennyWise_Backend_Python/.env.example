# PennyWise Backend Environment Configuration Example
# Copy this file to .env and customize with your local MySQL and Flask settings

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000
HOST=0.0.0.0
SECRET_KEY=replace-with-a-secure-random-secret-key

# MySQL Database Configuration
# These must match the credentials set up by the database teammate
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=pennywise_user
MYSQL_PASSWORD=your_secure_mysql_password_here
MYSQL_DATABASE=pennywise
MYSQL_POOL_SIZE=5

# CORS Configuration (allow Lovable frontend origin or * for development)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5500,*
